<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SecondActivity">

    <Button
        android:id="@+id/buttonOpenThird"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/btn_activitate2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/titluActiv2"
        app:layout_constraintBottom_toTopOf="@+id/buttonOpenThird"
        app:layout_constraintEnd_toEndOf="@+id/buttonOpenThird"
        app:layout_constraintStart_toStartOf="@+id/buttonOpenThird"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/button2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/btn_back_to_first_activ"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/buttonOpenThird"
        app:layout_constraintTop_toBottomOf="@+id/buttonOpenThird" />
</androidx.constraintlayout.widget.ConstraintLayout>