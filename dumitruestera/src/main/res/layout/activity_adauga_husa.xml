<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AdaugaHusa">

    <TextView
        android:id="@+id/dumitru_estera_textView_culoare"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Alege o culoare"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <RadioGroup
        android:id="@+id/dumitru_estera_radioGroup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/dumitru_estera_textView_culoare"
        app:layout_constraintEnd_toEndOf="@+id/dumitru_estera_textView_culoare"
        app:layout_constraintStart_toStartOf="@+id/dumitru_estera_textView_culoare"
        app:layout_constraintTop_toTopOf="parent"
        tools:layout_editor_absoluteX="16dp">

        <RadioButton
            android:id="@+id/dumitru_estera_radioBtnRosu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="rosu" />

        <RadioButton
            android:id="@+id/dumitru_estera_radioBtnAlbastru"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ablastru" />
    </RadioGroup>

    <Switch
        android:id="@+id/dumitru_estera_switch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="samsumg/iphone"
        android:checked="false"
        tools:ignore="UseSwitchCompatOrMaterialXml"
        android:textSize="18sp"
        app:layout_constraintBottom_toTopOf="@+id/dumitru_estera_radioGroup"
        app:layout_constraintEnd_toEndOf="@+id/dumitru_estera_radioGroup"
        app:layout_constraintStart_toStartOf="@+id/dumitru_estera_radioGroup"
        app:layout_constraintTop_toTopOf="parent"
        />

    <Spinner
        android:id="@+id/dumitru_estera_spinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="5"
        android:hint="Model"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/dumitru_estera_switch"
        app:layout_constraintTop_toBottomOf="@+id/dumitru_estera_switch"
        />

    <Button
        android:id="@+id/dumitru_estera_button_salveaza"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="Salveaza datele"
        tools:layout_editor_absoluteY="586dp" />

</androidx.constraintlayout.widget.ConstraintLayout>